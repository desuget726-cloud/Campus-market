TRUSTED_PROXY_IPS=
# Optional path to a local MaxMind GeoIP2/GeoLite2 City database (.mmdb).
GEOIP_DATABASE_PATH=replace-with-a-long-random-value
TOTP_ENCRYPTION_KEY=generate-a-fernet-key-and-store-it-securely
# Must never be true in production.
DISABLE_ADMIN_2FA=false
MAX_TOTAL_ADMINS=3
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
